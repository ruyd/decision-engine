{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "engine.api:app", "--port", "8000", "--reload", "--reload-dir", "engine", "--reload-dir", "fraud_model"],
      "env": { "MLFLOW_DISABLE_AGENT_HINT": "1" },
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "web"],
      "port": 5173
    }
  ]
}
